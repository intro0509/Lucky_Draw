<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GRAND RAFFLE — 경품 추첨</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- 고급 세리프체: Playfair Display(영문 타이틀) + Noto Serif KR(한국어) -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <style>
        /* ── 리셋 & CSS 변수 ────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:         #111317;          /* 최하단 배경 */
            --bg2:        #1a1c23;          /* 패널 */
            --bg3:        #1e2130;          /* 카드 뒷면 */
            --gold:       #d4af37;          /* 샴페인 골드 */
            --gold-lt:    #f0d878;          /* 밝은 골드 */
            --gold-dim:   #9a7e28;          /* 어두운 골드 */
            --gold-faint: rgba(212,175,55,.1);
            --gold-line:  rgba(212,175,55,.22);
            --text:       #f2ede4;          /* 따뜻한 흰색 */
            --text-dim:   #8a8070;          /* 보조 텍스트 */
            --r:          6px;              /* 공통 border-radius */

            /* ★ 배경 이미지 설정 ★
               - 로컬 파일: url('bg.jpg')        → index3.html 과 같은 폴더에 파일 저장
               - 온라인 URL: url('https://....')
               - 사용 안 할 때: none             */
            --bg-image: url('DKL_5776.jpg');

            /* 이미지 위에 덮는 어두운 오버레이 투명도 (0.0 ~ 1.0)
               값이 클수록 이미지가 더 어둡게 보임 */
            --overlay-opacity: 0.72;
        }

        html { scroll-behavior: smooth; }

        body {
            min-height: 100vh;
            background-color: var(--bg);
            /* 배경 이미지: cover로 화면 가득 채우기, fixed로 스크롤 시 고정(패럴랙스 효과) */
            background-image: var(--bg-image);
            background-size: cover;
            background-position: center center;
            background-attachment: fixed;
            color: var(--text);
            font-family: 'Noto Serif KR', Georgia, serif;
            overflow-x: hidden;
        }

        /* 레이어 1: 배경 이미지 위 어두운 오버레이 — 가독성 확보 */
        body::before {
            content: '';
            position: fixed; inset: 0;
            background: rgba(10, 11, 15, var(--overlay-opacity));
            pointer-events: none; z-index: 0;
        }

        /* 레이어 2: 골드 방사형 빛 효과 */
        body::after {
            content: '';
            position: fixed; inset: 0;
            background:
                radial-gradient(ellipse 80% 55% at 15% 8%,  rgba(212,175,55,.06) 0%, transparent 60%),
                radial-gradient(ellipse 60% 45% at 85% 92%, rgba(212,175,55,.05) 0%, transparent 60%);
            pointer-events: none; z-index: 0;
        }

        /* ── 앱 래퍼 ──────────────────────────────── */
        .app {
            position: relative; z-index: 1;
            min-height: 100vh;
            display: flex; flex-direction: column; align-items: center;
            padding: 52px 24px 88px;
        }

        /* ═══════════════════════════════════════════
           HEADER
        ═══════════════════════════════════════════ */
        .site-header { text-align: center; margin-bottom: 56px; }

        .hdr-eyebrow {
            font-family: 'Playfair Display', serif;
            font-size: 10px; letter-spacing: 8px; text-transform: uppercase;
            color: var(--gold); opacity: .7; margin-bottom: 14px;
        }

        .hdr-title {
            font-family: 'Playfair Display', serif;
            font-weight: 400;
            font-size: clamp(2.8rem, 7vw, 5rem);
            line-height: 1.05; letter-spacing: .04em; color: var(--text);
        }

        .hdr-title .accent { color: var(--gold); font-style: italic; }

        /* 헤더 장식 선 */
        .ornament {
            display: flex; align-items: center; justify-content: center;
            gap: 10px; margin-top: 18px;
        }
        .ornament::before, .ornament::after {
            content: ''; width: 72px; height: 1px;
        }
        .ornament::before { background: linear-gradient(90deg,  transparent, var(--gold-line)); }
        .ornament::after  { background: linear-gradient(270deg, transparent, var(--gold-line)); }
        .ornament-gem { font-size: 9px; color: var(--gold); opacity: .55; letter-spacing: 3px; }

        /* ═══════════════════════════════════════════
           SETUP SECTION
        ═══════════════════════════════════════════ */
        .setup-section {
            width: 100%; max-width: 900px;
            animation: fadeUp .7s ease both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(24px); }
            to   { opacity: 1; transform: translateY(0);    }
        }

        .setup-grid {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px; align-items: start;
        }
        @media (max-width: 720px) { .setup-grid { grid-template-columns: 1fr; } }

        /* 패널 공통 */
        .panel {
            background: var(--bg2);
            border: 1px solid var(--gold-line);
            border-radius: var(--r);
            padding: 24px 28px;
        }

        .panel-label {
            font-family: 'Playfair Display', serif;
            font-size: 10px; letter-spacing: 5px; text-transform: uppercase;
            color: var(--gold-dim); margin-bottom: 16px;
        }

        /* 참가자 텍스트에어리어 */
        .ptx {
            width: 100%; height: 295px;
            background: rgba(0,0,0,.22);
            border: 1px solid var(--gold-line); border-radius: 4px;
            color: var(--text);
            font-family: 'Noto Serif KR', serif;
            font-size: 13.5px; line-height: 1.9;
            padding: 14px 16px;
            resize: vertical; outline: none;
            transition: border-color .3s;
            caret-color: var(--gold);
        }
        .ptx:focus { border-color: rgba(212,175,55,.5); background: rgba(0,0,0,.28); }
        .ptx::placeholder { color: rgba(138,128,112,.5); font-size: 12px; line-height: 1.85; }

        .ptx-meta {
            display: flex; justify-content: space-between;
            align-items: center; margin-top: 8px;
        }
        .ptx-hint  { font-size: 11px; color: var(--text-dim); line-height: 1.5; }
        .ptx-count { font-family: 'Playfair Display', serif; font-size: 11px; color: var(--gold-dim); white-space: nowrap; margin-left: 10px; }

        /* 우측 설정 컬럼 */
        .settings-col { display: flex; flex-direction: column; gap: 20px; }

        /* 당첨 인원 입력 */
        .winner-input {
            width: 100%;
            background: rgba(0,0,0,.25);
            border: 1px solid var(--gold-line); border-radius: 4px;
            color: var(--text);
            font-family: 'Playfair Display', serif;
            font-size: 38px; font-weight: 400; text-align: center;
            padding: 10px 12px; outline: none;
            transition: border-color .3s;
            -moz-appearance: textfield;
            appearance: textfield;
        }
        .winner-input::-webkit-inner-spin-button,
        .winner-input::-webkit-outer-spin-button { -webkit-appearance: none; appearance: none; }
        .winner-input:focus { border-color: rgba(212,175,55,.5); }

        .stepper { display: flex; gap: 8px; margin-top: 10px; }

        .step-btn {
            flex: 1; height: 38px;
            background: var(--gold-faint);
            border: 1px solid var(--gold-line); border-radius: 3px;
            color: var(--gold); font-size: 22px; line-height: 1;
            cursor: pointer; user-select: none;
            transition: background .2s, border-color .2s;
        }
        .step-btn:hover { background: rgba(212,175,55,.2); border-color: rgba(212,175,55,.45); }

        /* 안내 목록 */
        .guide-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
        .guide-list li { font-size: 12px; color: var(--text-dim); line-height: 1.6; display: flex; gap: 10px; }
        .guide-list li .sn {
            font-family: 'Playfair Display', serif; font-size: 10px;
            letter-spacing: 1px; color: var(--gold-dim);
            flex-shrink: 0; margin-top: 2px;
        }

        /* ── 추첨 시작 버튼 ─────────────────────────── */
        .cta-wrap { margin-top: 28px; display: flex; justify-content: center; }

        .cta-btn {
            position: relative;
            padding: 17px 68px;
            background: transparent;
            border: 1px solid var(--gold); border-radius: 2px;
            color: var(--gold);
            font-family: 'Playfair Display', serif;
            font-size: 15px; letter-spacing: 5px; text-transform: uppercase;
            cursor: pointer; overflow: hidden; outline: none;
            transition: color .4s;
        }
        /* 호버 시 배경이 좌→우로 슬라이드 채워지는 효과 */
        .cta-btn::before {
            content: ''; position: absolute; inset: 0;
            background: var(--gold);
            transform: scaleX(0); transform-origin: left center;
            transition: transform .45s cubic-bezier(.22,1,.36,1);
        }
        .cta-btn:hover::before,
        .cta-btn:focus-visible::before { transform: scaleX(1); }
        .cta-btn:hover,
        .cta-btn:focus-visible { color: #111317; }
        .cta-btn .btn-text { position: relative; z-index: 1; }

        /* ═══════════════════════════════════════════
           RESULT SECTION
        ═══════════════════════════════════════════ */
        .result-section {
            display: none;
            width: 100%; max-width: 1160px;
            flex-direction: column; align-items: center;
        }
        .result-section.visible { display: flex; }

        .result-header {
            text-align: center; margin-bottom: 48px;
            animation: fadeUp .6s ease both;
        }
        .result-badge {
            font-family: 'Playfair Display', serif;
            font-size: 10px; letter-spacing: 7px; text-transform: uppercase;
            color: var(--gold-dim); margin-bottom: 10px;
        }
        .result-heading {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.6rem, 3.5vw, 2.4rem);
            font-weight: 400; color: var(--text);
        }
        .result-heading .cnt { color: var(--gold); font-style: italic; }
        .flip-prompt { margin-top: 10px; font-size: 12px; color: var(--text-dim); letter-spacing: .5px; }

        /* ── 카드 그리드 ───────────────────────────── */
        .cards-grid {
            display: flex; flex-wrap: wrap;
            justify-content: center; gap: 20px; width: 100%;
        }

        /* ═══════════════════════════════════════════
           CARD — stagger 입장 애니메이션
        ═══════════════════════════════════════════ */
        .card-wrapper {
            animation: cardIn .65s cubic-bezier(.34,1.38,.64,1) both;
            animation-delay: var(--stagger, 0s);
        }

        @keyframes cardIn {
            0%   { opacity: 0; transform: translateY(56px) scale(.85) rotate(-2deg); }
            100% { opacity: 1; transform: translateY(0)    scale(1)   rotate(0deg);  }
        }

        /* 3D 원근감 컨테이너: perspective 값이 클수록 덜 과장된 원근감 */
        .card-scene {
            width: 175px; height: 265px;
            perspective: 1100px;
            cursor: pointer;
        }

        /* flip 상태 보유 — transform-style: preserve-3d 필수 */
        .card-inner {
            width: 100%; height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform .9s cubic-bezier(.22,1,.36,1);
            border-radius: var(--r);
        }

        /* 뒤집힌 상태: Y축 180° 회전 */
        .card-inner.is-flipped { transform: rotateY(180deg); }

        /* 호버 시 살짝 기울어짐 (미공개 카드만 적용) */
        .card-scene:hover .card-inner:not(.is-flipped) {
            transform: rotateY(14deg) translateY(-5px);
            filter: drop-shadow(-6px 14px 28px rgba(0,0,0,.55));
        }

        /* 앞·뒷면 공통 스타일 */
        .card-face {
            position: absolute; inset: 0;
            border-radius: var(--r);
            /* backface-visibility: hidden 으로 반대면이 비치지 않도록 처리 */
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            overflow: hidden;
        }

        /* ─── 카드 뒷면 ─────────────────────────── */
        .card-back {
            background: linear-gradient(150deg, #1e2135 0%, #12141d 100%);
            border: 1px solid rgba(212,175,55,.28);
            display: flex; align-items: center; justify-content: center;
        }

        /* 다이아몬드 격자 문양 (CSS repeating-linear-gradient) */
        .card-back::before {
            content: ''; position: absolute; inset: 0;
            background-image:
                repeating-linear-gradient( 45deg, rgba(212,175,55,.065) 0, rgba(212,175,55,.065) 1px, transparent 0, transparent 50%),
                repeating-linear-gradient(-45deg, rgba(212,175,55,.065) 0, rgba(212,175,55,.065) 1px, transparent 0, transparent 50%);
            background-size: 18px 18px;
            border-radius: var(--r);
        }

        /* 안쪽 얇은 테두리 장식 */
        .card-back::after {
            content: ''; position: absolute; inset: 9px;
            border: 1px solid rgba(212,175,55,.17);
            border-radius: 3px;
        }

        /* 중앙 엠블럼 */
        .emblem {
            position: relative; z-index: 1;
            display: flex; flex-direction: column;
            align-items: center; gap: 6px;
        }
        .emblem-text {
            font-family: 'Playfair Display', serif;
            font-size: 8px; letter-spacing: 5px;
            color: var(--gold); opacity: .55; text-transform: uppercase;
        }
        .emblem-icon {
            font-size: 30px; color: var(--gold); opacity: .72;
            text-shadow: 0 0 22px rgba(212,175,55,.45); line-height: 1;
        }
        .emblem-hr {
            width: 36px; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(212,175,55,.45), transparent);
        }

        /* 카드 뒷면을 주기적으로 스쳐지나가는 광택(shimmer) 효과 */
        .card-shine {
            position: absolute; inset: 0;
            border-radius: var(--r); overflow: hidden; pointer-events: none;
        }
        .card-shine::after {
            content: ''; position: absolute;
            top: -100%; left: -70%;
            width: 45%; height: 300%;
            background: linear-gradient(
                105deg,
                transparent 30%,
                rgba(255,255,255,.06) 48%,
                rgba(255,255,255,.045) 52%,
                transparent 70%
            );
            animation: shimmer 5.5s ease-in-out infinite;
            animation-delay: var(--stagger, 0s);
        }

        @keyframes shimmer {
            0%   { transform: translateX(0)    skewX(-15deg); }
            28%  { transform: translateX(480%) skewX(-15deg); }
            100% { transform: translateX(480%) skewX(-15deg); }
        }

        /* ─── 카드 앞면 ─────────────────────────── */
        /* rotateY(180deg): 초기엔 뒤집혀 숨겨진 상태. is-flipped 시 정면으로 옴 */
        .card-front {
            transform: rotateY(180deg);
            background: linear-gradient(160deg, #23263a 0%, #181a27 100%);
            border: 1px solid rgba(212,175,55,.42);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            padding: 22px 18px; gap: 0;
        }

        /* 상단 골드 포인트 라인 */
        .card-front::before {
            content: ''; position: absolute;
            top: 0; left: 15%; right: 15%; height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
        }

        /* 하단 골드 포인트 라인 */
        .card-front::after {
            content: ''; position: absolute;
            bottom: 0; left: 15%; right: 15%; height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
        }

        .card-no {
            font-family: 'Playfair Display', serif;
            font-size: 10px; letter-spacing: 4px;
            color: var(--gold); opacity: .65; margin-bottom: 10px;
        }

        .card-hr-front {
            width: 28px; height: 1px;
            background: rgba(212,175,55,.3); margin-bottom: 12px;
        }

        .card-name {
            font-family: 'Noto Serif KR', serif;
            font-weight: 600; text-align: center;
            color: var(--text); line-height: 1.3;
            word-break: keep-all; margin-bottom: 8px;
            /* font-size는 JS에서 이름 길이에 따라 인라인 설정 */
        }

        .card-affiliation {
            font-family: 'Noto Serif KR', serif;
            font-weight: 300; font-size: 11.5px;
            color: var(--gold-dim); text-align: center;
            letter-spacing: 1.5px; word-break: keep-all; line-height: 1.4;
        }

        .card-stars {
            margin-top: 14px;
            font-size: 9px; color: var(--gold); opacity: .42; letter-spacing: 6px;
        }

        /* ═══════════════════════════════════════════
           결과 하단 액션 버튼
        ═══════════════════════════════════════════ */
        .result-actions {
            display: flex; gap: 14px; margin-top: 52px;
            flex-wrap: wrap; justify-content: center;
        }

        .action-btn {
            padding: 13px 40px;
            background: transparent;
            border: 1px solid rgba(212,175,55,.35); border-radius: 2px;
            color: var(--gold-dim);
            font-family: 'Playfair Display', serif;
            font-size: 12px; letter-spacing: 3.5px; text-transform: uppercase;
            cursor: pointer; outline: none;
            transition: all .3s;
        }
        .action-btn:hover, .action-btn:focus-visible {
            background: var(--gold-faint); border-color: var(--gold); color: var(--gold);
        }
        .action-btn.primary {
            background: var(--gold-faint);
            border-color: rgba(212,175,55,.5); color: var(--gold);
        }
        .action-btn.primary:hover, .action-btn.primary:focus-visible {
            background: var(--gold); color: #111317;
        }

        /* ── 푸터 ─────────────────────────────────── */
        .site-footer {
            margin-top: 72px; text-align: center;
            font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
            color: rgba(138,128,112,.32);
        }
    </style>
</head>
<body>

<div class="app">

    <!-- ═══ HEADER ═══ -->
    <header class="site-header">
        <p class="hdr-eyebrow">Luxury Event Experience</p>
        <h1 class="hdr-title">Grand <span class="accent">Raffle</span></h1>
        <div class="ornament"><span class="ornament-gem">◆ ◇ ◆</span></div>
    </header>

    <!-- ═══ SETUP SECTION ═══ -->
    <section class="setup-section" id="setupSection">
        <div class="setup-grid">

            <!-- 참가자 명단 입력 패널 -->
            <div class="panel">
                <p class="panel-label">Participants — 참가자 명단</p>
                <textarea
                    class="ptx" id="participantsInput"
                    spellcheck="false" autocomplete="off"
                    placeholder="참가자를 한 줄에 한 명씩 입력하세요.&#10;&#10;【 직접 입력 】&#10;이름만, 또는 이름 뒤에 Tab 키 후 소속 입력&#10;예)  홍길동&#10;     김철수	개발팀&#10;&#10;【 엑셀 붙여넣기 】&#10;엑셀에서 이름·소속 두 열을 선택 → Ctrl+C&#10;→ 이 칸에 Ctrl+V (탭 구분 자동 인식)"
                ></textarea>
                <div class="ptx-meta">
                    <span class="ptx-hint">엑셀 복사 붙여넣기 및 이름만 입력 모두 지원됩니다</span>
                    <span class="ptx-count" id="participantCount">0명</span>
                </div>
            </div>

            <!-- 우측 설정 컬럼 -->
            <div class="settings-col">

                <!-- 당첨 인원 설정 -->
                <div class="panel">
                    <p class="panel-label">Winners — 당첨 인원</p>
                    <input type="number" class="winner-input" id="winnerCount" value="1" min="1">
                    <div class="stepper">
                        <button class="step-btn" id="btnMinus" aria-label="감소">−</button>
                        <button class="step-btn" id="btnPlus"  aria-label="증가">+</button>
                    </div>
                </div>

                <!-- 사용 안내 -->
                <div class="panel">
                    <p class="panel-label">Guide — 사용 방법</p>
                    <ol class="guide-list">
                        <li><span class="sn">01.</span>참가자 명단을 입력하거나 붙여넣으세요</li>
                        <li><span class="sn">02.</span>당첨 인원 수를 설정하세요</li>
                        <li><span class="sn">03.</span>추첨 시작 버튼을 누르세요</li>
                        <li><span class="sn">04.</span>카드를 클릭해 당첨자를 공개하세요</li>
                    </ol>
                </div>

            </div>
        </div>

        <!-- 추첨 시작 CTA -->
        <div class="cta-wrap">
            <button class="cta-btn" id="drawBtn">
                <span class="btn-text">✦&ensp; 추첨 시작 &ensp;✦</span>
            </button>
        </div>
    </section>

    <!-- ═══ RESULT SECTION ═══ -->
    <section class="result-section" id="resultSection">

        <div class="result-header">
            <p class="result-badge">— Winners Announced —</p>
            <h2 class="result-heading">
                당첨자 <span class="cnt" id="winnerDisplay">0</span>명이 선정되었습니다
            </h2>
            <p class="flip-prompt">카드를 클릭하면 당첨자가 공개됩니다 &nbsp;✦</p>
        </div>

        <!-- 카드들이 JS로 동적 삽입되는 영역 -->
        <div class="cards-grid" id="cardsGrid"></div>

        <div class="result-actions">
            <button class="action-btn primary" id="revealAllBtn">모두 공개</button>
            <button class="action-btn"         id="resetBtn">다시 추첨</button>
        </div>

    </section>

    <footer class="site-footer">
        Grand Raffle &nbsp;◆&nbsp; Luxury Event Experience
    </footer>

</div><!-- /.app -->

<script>
    /* ═══════════════════════════════════════════════════════
       UTIL: Fisher-Yates 알고리즘 — 배열을 무작위로 섞기
       원본 배열을 훼손하지 않도록 복사본에서 수행
    ═══════════════════════════════════════════════════════ */
    function shuffle(arr) {
        const a = [...arr];
        for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
    }

    /* ═══════════════════════════════════════════════════════
       PARSER: 텍스트에어리어 → 참가자 배열
       - 줄바꿈(\n)으로 행 분리
       - 각 행을 탭(\t)으로 분리 → [이름, 소속] (엑셀 붙여넣기 지원)
       - 이름만 있는 행도 허용
    ═══════════════════════════════════════════════════════ */
    function parseParticipants(raw) {
        return raw
            .split('\n')
            .map(l => l.trim())
            .filter(l => l.length > 0)
            .map(l => {
                const parts = l.split('\t').map(s => s.trim());
                return { name: parts[0] || '', affiliation: parts[1] || '' };
            })
            .filter(p => p.name.length > 0);
    }

    /* ═══════════════════════════════════════════════════════
       UTIL: XSS 방지 — 문자열을 안전한 HTML 텍스트 노드로 변환
    ═══════════════════════════════════════════════════════ */
    function safe(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    /* ═══════════════════════════════════════════════════════
       CARD FACTORY: 카드 DOM 엘리먼트 생성
       - winner : { name, affiliation }
       - index  : 0-based 순서 (stagger delay 계산용)
    ═══════════════════════════════════════════════════════ */
    function createCard(winner, index) {
        /* stagger delay — 카드가 많아도 최대 2.5s로 제한 */
        const delay = `${Math.min(index * 0.11, 2.5)}s`;

        /* 이름 길이에 따라 폰트 크기 자동 조정 (카드 넘침 방지) */
        const nameLen = winner.name.length;
        const nameFsz = nameLen <= 4 ? '24px' : nameLen <= 7 ? '20px' : '15px';

        const wrapper = document.createElement('div');
        wrapper.className = 'card-wrapper';
        wrapper.style.setProperty('--stagger', delay);

        wrapper.innerHTML = `
            <div class="card-scene" role="button" tabindex="0"
                 aria-label="${safe(winner.name)} 카드 — 클릭해서 공개">
                <div class="card-inner">

                    <!-- 카드 뒷면: 다이아몬드 격자 + 엠블럼 + shimmer -->
                    <div class="card-face card-back" aria-hidden="true">
                        <div class="card-shine"></div>
                        <div class="emblem">
                            <div class="emblem-text">Grand</div>
                            <div class="emblem-hr"></div>
                            <div class="emblem-icon">✦</div>
                            <div class="emblem-hr"></div>
                            <div class="emblem-text">Raffle</div>
                        </div>
                    </div>

                    <!-- 카드 앞면: 당첨자 이름 + 소속 -->
                    <div class="card-face card-front" aria-hidden="true">
                        <div class="card-no">No.&nbsp;${String(index + 1).padStart(2, '0')}</div>
                        <div class="card-hr-front"></div>
                        <div class="card-name" style="font-size:${nameFsz}">${safe(winner.name)}</div>
                        ${winner.affiliation
                            ? `<div class="card-affiliation">${safe(winner.affiliation)}</div>`
                            : ''}
                        <div class="card-stars">✦ ✦ ✦</div>
                    </div>

                </div><!-- /.card-inner -->
            </div><!-- /.card-scene -->
        `;

        /* 클릭 / 키보드(Enter, Space)로 카드 뒤집기 */
        const scene = wrapper.querySelector('.card-scene');
        const inner = wrapper.querySelector('.card-inner');

        function flip() {
            inner.classList.toggle('is-flipped');
            scene.setAttribute('aria-label',
                inner.classList.contains('is-flipped')
                    ? `${safe(winner.name)} — 공개됨`
                    : `${safe(winner.name)} 카드 — 클릭해서 공개`
            );
        }

        scene.addEventListener('click', flip);
        scene.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); }
        });

        return wrapper;
    }

    /* ═══════════════════════════════════════════════════════
       DRAW: 추첨 실행 메인 함수
    ═══════════════════════════════════════════════════════ */
    function runDraw() {
        const rawText     = document.getElementById('participantsInput').value;
        const winnerCount = parseInt(document.getElementById('winnerCount').value, 10);

        if (!rawText.trim()) {
            alert('참가자 명단을 입력해 주세요.');
            return;
        }

        const participants = parseParticipants(rawText);

        if (participants.length === 0) {
            alert('유효한 참가자 데이터가 없습니다.\n명단을 다시 확인해 주세요.');
            return;
        }

        if (!Number.isInteger(winnerCount) || winnerCount < 1) {
            alert('당첨 인원은 1명 이상이어야 합니다.');
            return;
        }

        /* 참가자 수보다 당첨 인원이 많으면 경고 후 중단 */
        if (winnerCount > participants.length) {
            alert(
                `당첨 인원(${winnerCount}명)이 참가자 수(${participants.length}명)보다 많습니다.\n` +
                `당첨 인원을 줄이거나 참가자를 추가해 주세요.`
            );
            return;
        }

        /* Fisher-Yates 셔플 후 앞에서 winnerCount명 추출 */
        const winners = shuffle(participants).slice(0, winnerCount);

        /* UI 전환: 설정 화면 숨기기 → 결과 화면 표시 */
        document.getElementById('setupSection').style.display = 'none';
        const resultSection = document.getElementById('resultSection');
        resultSection.classList.add('visible');

        document.getElementById('winnerDisplay').textContent = winners.length;

        /* 카드 그리드 초기화 후 동적 생성 */
        const grid = document.getElementById('cardsGrid');
        grid.innerHTML = '';
        winners.forEach((winner, i) => grid.appendChild(createCard(winner, i)));

        /* 결과 영역 상단으로 부드럽게 스크롤 */
        resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* ═══════════════════════════════════════════════════════
       REVEAL ALL: 미공개 카드를 160ms 간격으로 순차 뒤집기
    ═══════════════════════════════════════════════════════ */
    function revealAll() {
        const unflipped = [...document.querySelectorAll('.card-inner:not(.is-flipped)')];
        unflipped.forEach((inner, i) => {
            setTimeout(() => inner.classList.add('is-flipped'), i * 160);
        });
    }

    /* ═══════════════════════════════════════════════════════
       RESET: 설정 화면으로 복귀 (참가자 명단은 유지)
    ═══════════════════════════════════════════════════════ */
    function resetDraw() {
        document.getElementById('setupSection').style.display = '';
        document.getElementById('resultSection').classList.remove('visible');
        document.getElementById('cardsGrid').innerHTML = '';
        document.getElementById('setupSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* ═══════════════════════════════════════════════════════
       이벤트 바인딩
    ═══════════════════════════════════════════════════════ */
    document.getElementById('drawBtn').addEventListener('click', runDraw);
    document.getElementById('revealAllBtn').addEventListener('click', revealAll);
    document.getElementById('resetBtn').addEventListener('click', resetDraw);

    /* 참가자 수 실시간 카운터 — 입력할 때마다 우측 하단에 "N명" 표시 */
    document.getElementById('participantsInput').addEventListener('input', () => {
        const n = parseParticipants(document.getElementById('participantsInput').value).length;
        document.getElementById('participantCount').textContent = `${n}명`;
    });

    /* 당첨 인원 ± 스텝 버튼 */
    document.getElementById('btnPlus').addEventListener('click', () => {
        const el = document.getElementById('winnerCount');
        el.value = Math.max(1, (parseInt(el.value) || 0) + 1);
    });
    document.getElementById('btnMinus').addEventListener('click', () => {
        const el = document.getElementById('winnerCount');
        el.value = Math.max(1, (parseInt(el.value) || 2) - 1);
    });
</script>

</body>
</html>
